/*
 * osmulres.rc - resource for Osuwari Multi for OS/2
 *
 * The texts are not in the resources: they come from the UTF-8 language files
 * lang\*.txt at run time (see ostext.c).  The menu and the dialog captions
 * below are only English placeholders; labels are "OsUniText" controls and
 * the buttons are owner drawn.
 */

#include <os2.h>
#include "osmulres.h"

ICON    ID_OSMULTI  osmulti.ico

POINTER ID_PTRFUNI  funi.ptr
POINTER ID_PTRNADE  nade.ptr

BITMAP  ID_MULNORM  mul_norm.bmp
BITMAP  ID_MULOHNO  mul_ohno.bmp
BITMAP  ID_MULPSYU  mul_psyu.bmp
BITMAP  ID_MULURU1  mul_urur.bmp
BITMAP  ID_MULURU2  mul_uru2.bmp
BITMAP  ID_MULCLOS  mul_clos.bmp

MENU    IDM_POPUP
BEGIN
    MENUITEM    "~Options...", IDM_SETUP
    SUBMENU     "~Language", IDM_SUBMENU_LANG
    BEGIN
        MENUITEM    "English", IDM_LANG_BASE
    END
    MENUITEM    "~About...",  IDM_ABOUT
    MENUITEM    SEPARATOR
    MENUITEM    "E~xit",      IDM_EXIT
END

DLGTEMPLATE IDD_SETUP
BEGIN
    DIALOG  "Sitting Multi - options", 0, 0, 0, 200, 68, ,
                                FCF_TITLEBAR | FCF_DLGBORDER
    BEGIN
        ICON    ID_OSMULTI, -1, 4, 40, 0, 0

        AUTOCHECKBOX "", IDD_SMSG, 40, 54, 12, 12, WS_GROUP
        CONTROL "", IDD_SMSG_L, 54, 55, 144, 10, "OsUniText", WS_VISIBLE
        AUTOCHECKBOX "", IDD_SSND, 40, 42, 12, 12
        CONTROL "", IDD_SSND_L, 54, 43, 144, 10, "OsUniText", WS_VISIBLE

        CONTROL "", IDD_SPOS_L, 40, 34, 104, 8, "OsUniText", WS_VISIBLE
        LTEXT "99%", IDD_SNUM, 148, 34, 28, 8

        CONTROL "", IDD_SPOS,   40, 14, 158, 20, WC_SLIDER,
                    SLS_HORIZONTAL | SLS_HOMELEFT |
                    WS_VISIBLE
        CTLDATA 12, 0, 101, 0, 101, 0

        CONTROL "", DID_OK,     20, 2, 70, 12, WC_BUTTON,
                    BS_USERBUTTON | BS_DEFAULT | WS_TABSTOP | WS_GROUP | WS_VISIBLE
        CONTROL "", DID_CANCEL, 110, 2, 70, 12, WC_BUTTON,
                    BS_USERBUTTON | WS_TABSTOP | WS_VISIBLE
    END
END

DLGTEMPLATE IDD_ABOUT
BEGIN
    DIALOG  "Sitting Multi for OS/2 PM", 0, 0, 0, 290, 118, ,
                                FCF_TITLEBAR | FCF_DLGBORDER
    BEGIN
        ICON    ID_OSMULTI, -1, 4, 94, 0, 0
        CONTROL "", IDD_ADESC, 40, 24, 248, 92, "OsUniText", WS_VISIBLE
        CONTROL "", DID_OK, 110, 4, 70, 14, WC_BUTTON,
                    BS_USERBUTTON | BS_DEFAULT | WS_TABSTOP | WS_GROUP | WS_VISIBLE
    END
END
